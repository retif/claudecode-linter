node_modules
dist/
*.tsbuildinfo
.claude/*
!tests/fixtures/**/.claude/
# worktree-discipline opt-in; must be committed to take effect. Note the
# rule above is `.claude/*` not `.claude/` — git cannot re-include a file
# whose parent DIRECTORY is excluded, so a negation under `.claude/` is inert.
!.claude/worktree-policy
CHANGELOG_ENTRY.md
.claude-code-version
*.tgz
.stage/

# spec-kit local/generated state (feature.json, extension-local config, integration scratch)
.specify/feature.json
.specify/extensions/*/local-config.yml
.specify/extensions/.cache/
.specify/extensions/.backup/
.specify/.tmp-integration/
