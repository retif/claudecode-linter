{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/present.sh"
          },
          {
            "type": "command",
            "command": "cd ${CLAUDE_PLUGIN_ROOT}/scripts && ./present.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/$HOOK_NAME.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/anything.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/missing.sh\" --flag"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PLUGIN_ROOT/scripts/also-missing.js"
          }
        ]
      }
    ]
  }
}
